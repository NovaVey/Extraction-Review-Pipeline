{
  "name": "@erp/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "zod": "^3.23.0",
    "pg": "^8.13.0",
    "drizzle-orm": "^0.36.0",
    "@anthropic-ai/sdk": "^0.115.0",
    "dotenv": "^16.4.0",
    "pino": "^9.0.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "pino-pretty": "^11.0.0",
    "@types/node": "^20.16.0",
    "@types/pg": "^8.11.0"
  }
}
