{
  "name": "extraction-review-pipeline",
  "private": true,
  "engines": {
    "node": ">=20 <21"
  },
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace api",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace api && npm run build --workspace web",
    "test": "npm run test --workspace api",
    "typecheck": "npm run typecheck --workspace api && npm run typecheck --workspace web",
    "gen:samples": "tsx scripts/make-synthetic-docs.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "@napi-rs/canvas": "^0.1.65"
  }
}
